{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "foundry.finding/0.1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "foundry.finding/0.1"
    },
    "render_id": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "kind": {
      "const": "ai_perceptual"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "frames": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "schema",
    "render_id",
    "source",
    "kind",
    "confidence",
    "frames",
    "objects",
    "evidence_refs",
    "note"
  ],
  "additionalProperties": false
}
