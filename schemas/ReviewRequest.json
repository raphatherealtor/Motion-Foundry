{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "foundry.review_request/0.1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "foundry.review_request/0.1"
    },
    "run_id": {
      "type": "string"
    },
    "base_revision_id": {
      "type": "string"
    },
    "base_render_id": {
      "type": "string"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "window": {
      "type": "object",
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "start",
        "end"
      ],
      "additionalProperties": false
    },
    "allowed_ops": {
      "const": "repair-allowlist.v1"
    },
    "budget": {
      "type": "object",
      "properties": {
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        }
      },
      "required": [
        "attempt",
        "max"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "run_id",
    "base_revision_id",
    "base_render_id",
    "attachments",
    "failures",
    "window",
    "allowed_ops",
    "budget"
  ],
  "additionalProperties": false
}
