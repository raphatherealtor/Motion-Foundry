{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "headline",
    "caption"
  ],
  "properties": {
    "headline": {
      "type": "string",
      "minLength": 1,
      "maxLength": 90
    },
    "caption": {
      "type": "string",
      "minLength": 1,
      "maxLength": 90
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 90
    },
    "lower_third": {
      "type": "string",
      "minLength": 1,
      "maxLength": 90
    },
    "values": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      }
    },
    "labels": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "string",
        "pattern": "^\\S+$",
        "maxLength": 12
      }
    }
  }
}
