{
  "schema": "repair-allowlist.motion-suite.v2",
  "rules": {
    "objects.*.transform.x": {
      "type": "integer",
      "min": 0,
      "max": 1080
    },
    "objects.*.transform.y": {
      "type": "integer",
      "min": 0,
      "max": 1920
    },
    "objects.*.transform.scale": {
      "type": "number",
      "min": 0.25,
      "max": 3
    },
    "objects.*.transform.rotation": {
      "type": "number",
      "min": -30,
      "max": 30
    },
    "objects.*.transform.z": {
      "type": "number",
      "min": -2000,
      "max": 2000
    },
    "objects.*.text.fontSize": {
      "type": "integer",
      "min": 40,
      "max": 160
    },
    "objects.*.text.lineHeight": {
      "type": "number",
      "min": 0.9,
      "max": 1.6
    },
    "objects.*.surface.shadowOpacity": {
      "type": "number",
      "min": 0,
      "max": 1
    },
    "objects.*.surface.shadowSoftness": {
      "type": "number",
      "min": 0,
      "max": 1
    },
    "objects.*.layout.align": {
      "type": "enum",
      "values": [
        "left",
        "center",
        "right"
      ]
    },
    "lighting.exposureEV": {
      "type": "number",
      "min": -2,
      "max": 2
    },
    "lighting.vignette": {
      "type": "number",
      "min": 0,
      "max": 1
    }
  },
  "easings": [
    "linear",
    "ease-in",
    "ease-out",
    "ease-in-out",
    "hold",
    "spring",
    "bounce",
    "elastic"
  ]
}
