{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "foundry.allowlist/0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "rules",
    "easings"
  ],
  "properties": {
    "schema": {
      "const": "repair-allowlist.motion-suite.v2"
    },
    "rules": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "enum": [
              "integer",
              "number",
              "enum"
            ]
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "values": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "easings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  }
}
